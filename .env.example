# .env.example
# Plantilla de variables de entorno para DB Scale Lab.
# Copiar a `.env` (ignorado por git) y completar con valores reales.
# Los valores de este archivo son FICTICIOS: no usar en ningún entorno real.
# Los secretos reales viven solo en `.env` (ver decisión D13 en
# .ai/conocimiento/decisiones-tecnicas.md).

# ---------------------------------------------------------------------------
# PostgreSQL — roles y contraseñas (mínimo privilegio, ver decisión D13 y
# propuesta-completa.md §2.9)
# ---------------------------------------------------------------------------

# Superusuario de PostgreSQL (administración, no lo usa la app)
PG_SUPERUSER_USER=postgres
PG_SUPERUSER_PASSWORD=changeme_superuser_ficticio

# Rol de escritura de la app (SELECT/INSERT/UPDATE sobre las tablas de negocio)
APP_WRITER_USER=app_writer
APP_WRITER_PASSWORD=changeme_writer_ficticio

# Rol de lectura de la app (solo SELECT, contra las réplicas)
APP_READER_USER=app_reader
APP_READER_PASSWORD=changeme_reader_ficticio

# Rol de replicación física entre primario y réplicas (solo permiso REPLICATION)
REPLICATOR_USER=replicator
REPLICATOR_PASSWORD=changeme_replicator_ficticio

# Rol de monitoreo (pg_monitor), usado por postgres_exporter
MONITOR_USER=monitor
MONITOR_PASSWORD=changeme_monitor_ficticio

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana_ficticio

# ---------------------------------------------------------------------------
# Comportamiento de la aplicación (ver propuesta-completa.md §2.6)
# ---------------------------------------------------------------------------

# Si una réplica todavía no tiene la fila por lag de replicación, permite que
# GET /products/{id} haga fallback de lectura al primario.
# Valores: true | false
READ_FALLBACK_TO_PRIMARY=false

# ---------------------------------------------------------------------------
# Límites de recursos por contenedor (decisión D11). Valores iniciales,
# se ajustan tras medir en las fases de carga.
# ---------------------------------------------------------------------------

# PostgreSQL: mismo presupuesto en el primario y en cada réplica
POSTGRES_CPUS=2
POSTGRES_MEM=3g

# API (FastAPI/gunicorn)
API_CPUS=4

# Generador de carga k6
K6_CPUS=4

# ---------------------------------------------------------------------------
# Nota: nombre de base de datos, hosts y puertos de conexión se agregan en la
# Fase 2 junto con demo/docker-compose.yml y demo/postgres/ (no se anticipan
# acá para no invadir decisiones de esa fase, que todavía no están tomadas).
# ---------------------------------------------------------------------------
