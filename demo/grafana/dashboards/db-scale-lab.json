{
  "title": "DB Scale Lab",
  "uid": "dbscale-lab",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Throughput API",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(api_requests_total[1m])) by (endpoint)",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latencia p95 por endpoint",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(api_request_latency_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Tasa de errores",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(api_errors_total[1m])) by (endpoint) or vector(0)",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Lecturas por nodo",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(api_reads_by_node_total[5m])) by (host)",
          "legendFormat": "{{host}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Conexiones activas (primario)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "pg_stat_database_numbackends{datname=\"dbscale\"}",
          "legendFormat": "conexiones"
        }
      ]
    },
    {
      "id": 6,
      "title": "TPS (commits)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_xact_commit{datname=\"dbscale\"}[1m]))",
          "legendFormat": "commits/s"
        }
      ]
    },
    {
      "id": 7,
      "title": "Cache hit ratio",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_blks_hit{datname=\"dbscale\"}[5m])) / (sum(rate(pg_stat_database_blks_hit{datname=\"dbscale\"}[5m])) + sum(rate(pg_stat_database_blks_read{datname=\"dbscale\"}[5m])))",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "id": 8,
      "title": "CPU por contenedor",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{name=~\"dbscale-pg-primary|dbscale-api|dbscale-prometheus|dbscale-grafana\"}[1m])) by (name)",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Memoria por contenedor",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "container_memory_usage_bytes{name=~\"dbscale-pg-primary|dbscale-api|dbscale-prometheus|dbscale-grafana\"}",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Estado de cada nodo (pg_up)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Caído", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "Up", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "pg_up{job=~\"pg-exporter-p|pg-exporter-1|pg-exporter-2\"}",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "Rol actual de cada nodo (primario vs réplica)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Primario", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "Réplica", "color": "blue" } } }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "pg_replication_is_replica{job=~\"pg-exporter-p|pg-exporter-1|pg-exporter-2\"}",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 12,
      "title": "Lag de replicación (WAL sin aplicar, medido en el primario)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 40 },
      "description": "pg_stat_replication_pg_wal_lsn_diff (postgres-exporter v0.20.1), medido en pg-exporter-p contra pg_stat_replication del primario. Bytes de WAL todavía no aplicados por cada réplica. No usar pg_replication_lag_seconds para esto: esa métrica crece también cuando no hay escrituras nuevas (tiempo desde la última transacción replicada, no lag de red real).",
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "pg_stat_replication_pg_wal_lsn_diff{job=\"pg-exporter-p\"}",
          "legendFormat": "{{client_addr}}"
        }
      ]
    }
  ]
}
